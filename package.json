{
    "name": "wakusei-homepage",
    "version": "2.0.0",
    "private": true,
    "description": "Wakusei 个人主页 - Astro + Vue static site",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=9.6.5"
    },
    "scripts": {
        "dev": "astro dev",
        "lint": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.test.ts\" astro.config.mjs",
        "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.test.ts\" astro.config.mjs --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,astro}\" \"tests/**/*.test.ts\" \"src/styles/**/*.css\" astro.config.mjs tsconfig.json package.json",
        "format:check": "prettier --check \"src/**/*.{ts,vue,astro}\" \"tests/**/*.test.ts\" \"src/styles/**/*.css\" astro.config.mjs tsconfig.json package.json",
        "build": "astro build",
        "check": "astro check",
        "serve": "npx serve dist",
        "preview": "astro preview",
        "test": "vitest run"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@types/node": "^22.14.1",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vue/test-utils": "^2.4.6",
        "astro": "^6.2.2",
        "eslint": "^8.56.0",
        "eslint-plugin-vue": "^10.1.0",
        "jsdom": "^26.1.0",
        "lighthouse": "^13.4.0",
        "prettier": "^3.2.0",
        "prettier-plugin-astro": "^0.14.1",
        "puppeteer-core": "^25.3.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-slug": "^6.0.0",
        "sharp": "^0.35.3",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3",
        "vitest": "^3.1.1",
        "zod": "^3.24.4"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.2",
        "@astrojs/vue": "^6.0.1",
        "pinia": "^3.0.2",
        "vue": "^3.5.13"
    }
}

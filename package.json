{
    "name": "wakusei-homepage",
    "version": "2.0.0",
    "private": true,
    "description": "Wakusei 个人主页 - Astro + Vue static site",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=9.6.5"
    },
    "scripts": {
        "dev": "astro dev",
        "lint": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.test.ts\" astro.config.mjs",
        "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"tests/**/*.test.ts\" astro.config.mjs --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,astro}\" \"tests/**/*.test.ts\" \"src/styles/**/*.css\" astro.config.mjs tsconfig.json package.json",
        "format:check": "prettier --check \"src/**/*.{ts,vue,astro}\" \"tests/**/*.test.ts\" \"src/styles/**/*.css\" astro.config.mjs tsconfig.json package.json",
        "build": "astro build",
        "check": "astro check",
        "serve": "npx serve dist",
        "preview": "astro preview",
        "test": "vitest run"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/markdown-remark": "^7.2.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vue/test-utils": "^2.4.11",
        "astro": "^7.1.3",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-slug": "^6.0.0",
        "sharp": "^0.35.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "zod": "^4.4.3"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.3",
        "@astrojs/vue": "^7.0.1",
        "pinia": "^4.0.2",
        "vue": "^3.5.40"
    }
}

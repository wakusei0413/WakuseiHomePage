---
import { siteConfig } from '../data/site';
import { translations } from '../data/i18n';
import type { DockItem, Locale } from '../types/site';
import { isDockLinkDisabled } from '../lib/dock';
import Icon from './Icon.astro';

interface Props {
    isHomePage?: boolean;
}

const { isHomePage: isHome = false } = Astro.props;
const barStyle = isHome ? 'transform:translateX(var(--left-panel-width,500px))' : '';
const leftStyle = isHome ? 'opacity:0;transform:translateY(8px)' : 'opacity:1';

function t(key: string, locale: Locale = 'zh-CN'): string {
    const cat = translations[locale] as Record<string, string> | undefined;
    return cat?.[key] ?? key;
}

function resolveDockLabel(display: { text?: string; i18nKey?: string }): string {
    return (t(display.i18nKey ?? '') || display.text) ?? '';
}

function resolveDockIcon(display: { icon?: string; iconActive?: string }, active: boolean): string {
    return active && display.iconActive ? display.iconActive : (display.icon ?? '');
}

const items: DockItem[] = siteConfig.dock.items;
const locales: Locale[] = siteConfig.i18n.locales;
const defaultLocale: Locale = siteConfig.i18n.defaultLocale;
---

<div class="top-bar" id="topBar" role="toolbar" aria-label="Top navigation" style={barStyle || undefined}>
    <div class="top-bar-left" id="topBarLeft" style={leftStyle || undefined}>
        <img class="top-bar-avatar" src={siteConfig.profile.avatar} alt="" width="40" height="40" />
        <span class="top-bar-name">{siteConfig.profile.name}</span>
    </div>

    <div class="top-bar-right" id="topBarRight">
        {
            items.map((item) => {
                if (item.type === 'divider') {
                    return <div class="top-bar-divider" />;
                }

                const label = resolveDockLabel(item.display);
                const iconName = resolveDockIcon(item.display, false);
                const mode = item.display.renderMode ?? 'icon';

                if (item.type === 'action') {
                    return (
                        <button
                            class="top-bar-dock-item"
                            class:list={{ 'has-text': mode !== 'icon' }}
                            data-action={item.action}
                            title={label}
                            aria-label={label}
                        >
                            {mode !== 'text' && <Icon name={iconName} />}
                            {(mode === 'text' || mode === 'both') && <span class="top-bar-dock-label">{label}</span>}
                        </button>
                    );
                }

                if (item.type === 'panel') {
                    return (
                        <button
                            class="top-bar-dock-item"
                            class:list={{ 'has-text': mode !== 'icon' }}
                            data-panel={item.panel}
                            title={label}
                            aria-label={label}
                        >
                            {mode !== 'text' && <Icon name={iconName} />}
                            {(mode === 'text' || mode === 'both') && <span class="top-bar-dock-label">{label}</span>}
                        </button>
                    );
                }

                const disabled = isDockLinkDisabled(item.href);
                if (item.openInNewTab) {
                    return (
                        <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="top-bar-dock-item"
                            class:list={{ 'has-text': mode !== 'icon' }}
                            title={label}
                            aria-label={label}
                        >
                            {mode !== 'text' && <Icon name={iconName} />}
                            {(mode === 'text' || mode === 'both') && <span class="top-bar-dock-label">{label}</span>}
                        </a>
                    );
                }
                return (
                    <a
                        href={disabled ? undefined : item.href}
                        class="top-bar-dock-item"
                        class:list={{ disabled, 'has-text': mode !== 'icon' }}
                        title={label}
                        aria-label={label}
                    >
                        {mode !== 'text' && <Icon name={iconName} />}
                        {(mode === 'text' || mode === 'both') && <span class="top-bar-dock-label">{label}</span>}
                    </a>
                );
            })
        }
    </div>
</div>

<!-- Language popup -->
<div class="top-bar-language-popup" id="topBarLanguagePopup" role="dialog" aria-label="Language selection">
    <div class="top-bar-popup-title">{t('dock.language')}</div>
    {
        locales.map((lang) => (
            <div
                class="top-bar-popup-option"
                class:list={{ selected: lang === defaultLocale }}
                data-locale={lang}
                role="option"
                aria-selected={lang === defaultLocale ? 'true' : 'false'}
            >
                <Icon name="check" class="check-icon" />
                <span>{t(`dock.lang.${lang}`)}</span>
            </div>
        ))
    }
</div>

<script>
    const bar = document.getElementById('topBar')!;
    const barLeft = document.getElementById('topBarLeft')!;
    const barRight = document.getElementById('topBarRight')!;
    const langPopup = document.getElementById('topBarLanguagePopup')!;
    const isMobile = window.matchMedia('(max-width: 900px)').matches;
    let isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    let popupOpen = false;
    let scroller: HTMLElement | null = null;
    let scrollCleanup: (() => void) | null = null;

    function expansionProgress(sp: number): number {
        if (sp <= 0.02) return 0;
        if (sp >= 0.45) return 1;
        const raw = (sp - 0.02) / 0.43;
        return 1 - Math.pow(1 - raw, 4);
    }

    function leftOpacity(sp: number): number {
        if (sp <= 0.15) return 0;
        if (sp >= 0.4) return 1;
        return (sp - 0.15) / 0.25;
    }

    function onScroll() {
        if (!scroller || isMobile) return;
        const sp = Math.min(scroller.scrollTop / window.innerHeight, 1);
        const ep = expansionProgress(sp);
        const lo = leftOpacity(sp);
        bar.style.transform = `translateX(calc(var(--left-panel-width, 500px) * ${1 - ep}))`;
        bar.style.opacity = '1';
        barRight.style.transform = `translateX(calc(var(--left-panel-width, 500px) * ${ep - 1}))`;
        barLeft.style.opacity = String(lo);
        barLeft.style.transform = `translateY(${(1 - lo) * 8}px)`;
    }

    function attachScroll() {
        if (scrollCleanup) { scrollCleanup(); scrollCleanup = null; }
        scroller = document.querySelector('.page-scroller');
        if (scroller && !isMobile) {
            scroller.addEventListener('scroll', onScroll, { passive: true });
            scrollCleanup = () => { scroller!.removeEventListener('scroll', onScroll); };
            onScroll();
        } else if (!scroller) {
            bar.style.transform = '';
            barRight.style.transform = '';
            barLeft.style.opacity = '1';
            barLeft.style.transform = '';
        }
    }

    attachScroll();
    requestAnimationFrame(() => requestAnimationFrame(attachScroll));
    window.addEventListener('wakusei:homepage-mounted', attachScroll);
    document.addEventListener('swup:contentReplaced', attachScroll);

    // ── Language popup ──
    function updatePopupPosition(btn: HTMLElement) {
        const rect = btn.getBoundingClientRect();
        langPopup.style.left = `${rect.left + rect.width / 2}px`;
        langPopup.style.top = `${rect.bottom + 8}px`;
    }

    function openPopup(btn: HTMLElement) {
        updatePopupPosition(btn);
        langPopup.setAttribute('data-open', '');
        popupOpen = true;
    }

    function closePopup() {
        langPopup.removeAttribute('data-open');
        popupOpen = false;
    }

    document.addEventListener('click', (e) => {
        if (!popupOpen) return;
        const target = e.target as Node;
        if (!bar.contains(target) && !langPopup.contains(target)) {
            closePopup();
        }
    });

    // ── Dock item handlers ──
    bar.querySelectorAll('[data-panel]').forEach((btn) => {
        const button = btn as HTMLElement;
        button.addEventListener('click', (e) => {
            e.stopPropagation();
            const panel = button.dataset.panel;
            if (panel === 'language') {
                if (popupOpen) closePopup();
                else openPopup(button);
            }
        });
    });

    function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        window.dispatchEvent(new CustomEvent('wakusei:theme-change'));
    }

    bar.querySelectorAll('[data-action="toggleTheme"]').forEach((btn) => {
        btn.addEventListener('click', () => {
            isDark = !isDark;
            const newTheme = isDark ? 'dark' : 'light';
            const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
            if (typeof doc.startViewTransition === 'function') {
                doc.startViewTransition(() => applyTheme(newTheme));
            } else {
                applyTheme(newTheme);
            }
        });
    });

    // ── Language selection ──
    langPopup.querySelectorAll('[data-locale]').forEach((el) => {
        el.addEventListener('click', () => {
            const locale = (el as HTMLElement).dataset.locale;
            if (locale) {
                localStorage.setItem('lang', locale);
                closePopup();
                window.dispatchEvent(new CustomEvent('wakusei:locale-changed', { detail: locale }));
            }
        });
    });

    // ── Icon magnify hover (desktop only) ──
    if (!isMobile) {
        const dockItems = bar.querySelectorAll('.top-bar-dock-item') as NodeListOf<HTMLElement>;
        let frameId: number | null = null;
        let latestMouseX = 0;

        const updateScales = () => {
            const rect = bar.getBoundingClientRect();
            dockItems.forEach((item) => {
                const itemRect = item.getBoundingClientRect();
                const itemCenter = itemRect.left - rect.left + itemRect.width / 2;
                const distance = Math.abs(latestMouseX - itemCenter);
                const scale = 1 + 0.12 * Math.exp(-(distance * distance) / (2 * 30 * 30));
                item.style.transform = `scale(${scale})`;
            });
            frameId = null;
        };

        bar.addEventListener('mousemove', (e) => {
            latestMouseX = e.clientX - bar.getBoundingClientRect().left;
            if (frameId === null) frameId = window.requestAnimationFrame(updateScales);
        });

        bar.addEventListener('mouseleave', () => {
            if (frameId !== null) {
                window.cancelAnimationFrame(frameId);
                frameId = null;
            }
            dockItems.forEach((item) => {
                item.style.transform = '';
            });
        });
    }

    // ── Mobile avatar click → open sidebar ──
    if (isMobile) {
        barLeft.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('wakusei:open-mobile-menu'));
        });
    }
</script>

---
import { siteConfig } from '../data/site';
import { translations } from '../data/i18n';
import type { DockItem, Locale } from '../types/site';
import { isDockLinkDisabled } from '../lib/dock';
import Icon from './Icon.astro';

function t(key: string, locale: Locale = 'zh-CN'): string {
    const cat = translations[locale] as Record<string, string> | undefined;
    return cat?.[key] ?? key;
}

function resolveDockLabel(display: { text?: string; i18nKey?: string }): string {
    return (t(display.i18nKey ?? '') || display.text) ?? '';
}

function resolveDockIcon(display: { icon?: string; iconActive?: string }, active: boolean): string {
    return active && display.iconActive ? display.iconActive : (display.icon ?? '');
}

const locale = siteConfig.i18n.defaultLocale as Locale;
const items: DockItem[] = siteConfig.dock.items;
const locales: Locale[] = siteConfig.i18n.locales;
---

<div class="mobile-dock-sidebar" id="mobileDockSidebar" role="dialog" aria-label="Menu">
    <div class="sidebar-header">
        <div class="sidebar-avatar-frame">
            <img
                src={siteConfig.profile.avatar}
                alt=""
                class="sidebar-avatar"
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
            />
        </div>
        <span class="sidebar-name">{siteConfig.profile.name}</span>
    </div>

    <div class="sidebar-divider"></div>

    {
        items.map((item) => {
            if (item.type === 'divider') {
                return <div class="sidebar-divider" />;
            }

            const label = resolveDockLabel(item.display);
            const iconName = resolveDockIcon(item.display, false);

            if (item.type === 'panel') {
                return (
                    <div class="sidebar-menu-group">
                        <button class="sidebar-menu-item" data-panel={item.panel} aria-expanded="false">
                            <Icon name={iconName} class="sidebar-menu-icon" />
                            <span>{label}</span>
                            <Icon name="fa-solid fa-chevron-down" class="expand-icon" />
                        </button>
                        <div class="sidebar-submenu">
                            {locales.map((lang) => (
                                <div
                                    class="sidebar-submenu-item"
                                    class:list={{ selected: lang === locale }}
                                    data-locale={lang}
                                    role="option"
                                >
                                    <Icon name="check" class="check-icon" />
                                    <span>{t(`dock.lang.${lang}`)}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                );
            }

            if (item.type === 'action') {
                return (
                    <button class="sidebar-menu-item" data-action={item.action}>
                        <Icon name={iconName} class="sidebar-menu-icon" />
                        <span>{label}</span>
                    </button>
                );
            }

            const disabled = isDockLinkDisabled(item.href);
            if (item.openInNewTab) {
                return (
                    <a href={item.href} target="_blank" rel="noopener noreferrer" class="sidebar-menu-item">
                        <Icon name={iconName} class="sidebar-menu-icon" />
                        <span>{label}</span>
                    </a>
                );
            }
            return (
                <a href={disabled ? undefined : item.href} class="sidebar-menu-item" class:list={{ disabled }}>
                    <Icon name={iconName} class="sidebar-menu-icon" />
                    <span>{label}</span>
                </a>
            );
        })
    }
</div>

<div class="mobile-dock-sidebar-overlay" id="mobileDockSidebarOverlay"></div>

<script>
    const sidebar = document.getElementById('mobileDockSidebar')!;
    const overlay = document.getElementById('mobileDockSidebarOverlay')!;
    const defaultTheme = document.documentElement.getAttribute('data-theme') || 'light';

    let isDark = defaultTheme === 'dark';

    function openSidebar() {
        sidebar.setAttribute('data-open', '');
        overlay.setAttribute('data-open', '');
    }

    function closeSidebar() {
        sidebar.removeAttribute('data-open');
        overlay.removeAttribute('data-open');
        const expanded = sidebar.querySelector('.sidebar-menu-item.expanded');
        if (expanded) {
            expanded.removeAttribute('aria-expanded');
            expanded.classList.remove('expanded');
        }
        const submenu = sidebar.querySelector('.sidebar-submenu.expanded') as HTMLElement | null;
        if (submenu) submenu.classList.remove('expanded');
    }

    window.addEventListener('wakusei:open-mobile-menu', openSidebar);
    overlay.addEventListener('click', closeSidebar);

    // Close on outside click
    document.addEventListener('click', (e) => {
        if (!sidebar.hasAttribute('data-open')) return;
        const target = e.target as Node;
        if (!sidebar.contains(target)) closeSidebar();
    });

    // Panel toggle (language submenu)
    sidebar.querySelectorAll('[data-panel]').forEach((btn) => {
        const button = btn as HTMLButtonElement;
        button.addEventListener('click', () => {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';
            button.setAttribute('aria-expanded', String(!isExpanded));
            button.classList.toggle('expanded', !isExpanded);
            const submenu = button.nextElementSibling as HTMLElement | null;
            if (submenu) submenu.classList.toggle('expanded', !isExpanded);
        });
    });

    // Language selection
    sidebar.querySelectorAll('[data-locale]').forEach((el) => {
        el.addEventListener('click', () => {
            const locale = (el as HTMLElement).dataset.locale;
            if (locale) {
                localStorage.setItem('lang', locale);
                closeSidebar();
                window.dispatchEvent(new CustomEvent('wakusei:locale-changed', { detail: locale }));
            }
        });
    });

    // Theme toggle
    function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        window.dispatchEvent(new CustomEvent('wakusei:theme-change'));
    }

    sidebar.querySelectorAll('[data-action="toggleTheme"]').forEach((btn) => {
        btn.addEventListener('click', () => {
            isDark = !isDark;
            const newTheme = isDark ? 'dark' : 'light';
            const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
            if (typeof doc.startViewTransition === 'function') {
                doc.startViewTransition(() => applyTheme(newTheme));
            } else {
                applyTheme(newTheme);
            }
        });
    });

    // Link items close sidebar on click
    sidebar.querySelectorAll('a.sidebar-menu-item').forEach((link) => {
        link.addEventListener('click', () => {
            setTimeout(closeSidebar, 100);
        });
    });

    // Disabled links
    sidebar.querySelectorAll('a.sidebar-menu-item.disabled').forEach((link) => {
        link.addEventListener('click', (e) => e.preventDefault());
    });
</script>

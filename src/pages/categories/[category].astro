---
import TaxonomyPage from '../../components/TaxonomyPage.vue';
import { siteConfig } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TaxonomyPageProps } from '../../lib/post-model';
import { getCategoryStaticPaths } from '../../lib/posts';

export { getCategoryStaticPaths as getStaticPaths };

const { term, terms, posts } = Astro.props as TaxonomyPageProps;
const title = `分类：${term.name}`;
const description = `收录 ${term.count} 篇关于「${term.name}」的文章。`;
---

<BaseLayout shellMode="blog" shellTitle={title} title={`${title} | ${siteConfig.title}`} description={description}>
    <TaxonomyPage
        client:idle
        variant="categories"
        title={title}
        description={description}
        terms={terms}
        activeTerm={term}
        posts={posts}
    />
</BaseLayout>

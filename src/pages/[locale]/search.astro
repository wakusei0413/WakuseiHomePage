---
import SearchPage from '../../components/SearchPage.vue';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedSiteMeta, translate, type Locale } from '../../lib/i18n';
import { NON_DEFAULT_LOCALES } from '../../lib/i18n-routing';
import { loadPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
    return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const posts = await loadPublishedPosts(locale);
const metaParams = { count: posts.length };
const title = translate(locale, 'pages.search.title', metaParams);
const description = translate(locale, 'pages.search.description', metaParams);
---

<BaseLayout
    shellMode="blog"
    shellTitle={title}
    title={`${title} | ${localizedSiteMeta(locale).title}`}
    description={description}
    locale={locale}
>
    <SearchPage client:load posts={posts} />
</BaseLayout>

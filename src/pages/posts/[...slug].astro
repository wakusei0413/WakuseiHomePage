---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.vue';
import PostFooterNav from '../../components/PostFooterNav.vue';
import PostMeta from '../../components/PostMeta.vue';
import ReadingControls from '../../components/ReadingControls.vue';
import { formatPostDateLabel } from '../../lib/post-model';
import { getPostStaticPaths, type PostPageProps } from '../../lib/posts';
import { createArticleSeoMetadata } from '../../lib/seo';
import { siteConfig } from '../../data/site';

export { getPostStaticPaths as getStaticPaths };

const { frontmatter, Content, readingMinutes, prev, next, coverMeta } = Astro.props as PostPageProps;
const pub = formatPostDateLabel(frontmatter.pubDate);
const updated = formatPostDateLabel(frontmatter.updatedDate);
const updatedForDisplay = updated && pub && updated.iso !== pub.iso ? updated : null;
const siteUrl = Astro.site ?? new URL('https://www.wakusei.top');
const siteHomeUrl = new URL('/', siteUrl).toString();
const articleImage = frontmatter.cover ? new URL(frontmatter.cover, siteUrl).toString() : undefined;
const articleSeo = createArticleSeoMetadata({
    publishedTime: frontmatter.pubDate,
    updatedTime: frontmatter.updatedDate,
    author: frontmatter.author,
    fallbackAuthor: {
        name: siteConfig.profile.name,
        url: siteHomeUrl
    },
    image: articleImage,
    language: frontmatter.language ?? siteConfig.lang,
    section: frontmatter.category,
    tags: frontmatter.tags
});
---

<BaseLayout
    shellMode="article"
    shellTitle={frontmatter.title}
    title={frontmatter.title}
    description={frontmatter.description}
    ogImage={articleImage}
    ogImageAlt={articleImage ? frontmatter.title : undefined}
    ogImageWidth={coverMeta?.width}
    ogImageHeight={coverMeta?.height}
    ogImageType={coverMeta ? `image/${coverMeta.format}` : undefined}
    articleSeo={articleSeo}
>
    <div class="reading-progress" aria-hidden="true">
        <div class="reading-progress__fill"></div>
    </div>
    <article class="post-container">
        <div class="post-lead">
            <header class="post-header">
                <h1 class="post-title">{frontmatter.title}</h1>
                <div class="post-meta">
                    {
                        frontmatter.tags && frontmatter.tags.length > 0 && (
                            <span class="post-tags">{frontmatter.tags.join(' · ')}</span>
                        )
                    }
                    {
                        pub && (
                            <time class="post-date" datetime={pub.iso}>
                                {pub.label}
                            </time>
                        )
                    }
                    <PostMeta client:idle readingMinutes={readingMinutes} updated={updatedForDisplay} />
                </div>
            </header>
            {
                frontmatter.cover && (
                    <div class="post-hero-image-wrapper">
                        <img
                            src={frontmatter.cover}
                            alt={frontmatter.title}
                            class="post-hero-image"
                            loading="eager"
                            decoding="async"
                            fetchpriority="high"
                            width="1400"
                            height="788"
                        />
                    </div>
                )
            }
        </div>
        <div class="post-body">
            <Content />
        </div>
        <PostFooterNav client:idle prev={prev} next={next} />
    </article>
    <ArticleToc client:idle={{ timeout: 500 }} />
    <ReadingControls client:idle />
</BaseLayout>

<script>
    import '../../scripts/article-runtime';
</script>

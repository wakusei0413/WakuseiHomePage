---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface MarkdownModule {
    frontmatter: {
        title: string;
        description: string;
        cover?: string;
        language?: string;
        tags?: string[];
        draft?: boolean;
        pubDate?: string;
        updatedDate?: string;
    };
    default: any;
}

export async function getStaticPaths() {
    const posts = import.meta.glob<MarkdownModule>('../../content/blog/**/index.md', { eager: true });
    const entries = Object.entries(posts);

    return entries
        .filter(([, mod]) => !mod.frontmatter.draft)
        .map(([filePath, mod]) => {
            const slug = filePath.replace('../../content/blog/', '').replace('/index.md', '');
            return {
                params: { slug },
                props: {
                    frontmatter: mod.frontmatter,
                    Content: mod.default
                }
            };
        });
}

const { frontmatter, Content } = Astro.props;

const formatDate = (raw?: string) => {
    if (!raw) return null;
    const d = new Date(raw);
    if (Number.isNaN(d.getTime())) return null;
    const y = d.getFullYear();
    const m = `${d.getMonth() + 1}`;
    const day = `${d.getDate()}`;
    return { iso: d.toISOString().slice(0, 10), label: `${y}年${m}月${day}日` };
};

const pub = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<BaseLayout
    shellMode="article"
    shellTitle={frontmatter.title}
    title={frontmatter.title}
    description={frontmatter.description}
>
    <article class="post-container">
        <header class="post-header">
            <h1 class="post-title">{frontmatter.title}</h1>
            <div class="post-meta">
                {
                    frontmatter.tags && frontmatter.tags.length > 0 && (
                        <span class="post-tags">{frontmatter.tags.join(' · ')}</span>
                    )
                }
                {
                    pub && (
                        <time class="post-date" datetime={pub.iso}>
                            {pub.label}
                        </time>
                    )
                }
                {
                    updated && pub && updated.iso !== pub.iso && (
                        <time class="post-date post-date--updated" datetime={updated.iso}>
                            更新于 {updated.label}
                        </time>
                    )
                }
            </div>
        </header>
        {
            frontmatter.cover && (
                <div class="post-hero-image-wrapper">
                    <img src={frontmatter.cover} alt={frontmatter.title} class="post-hero-image" loading="eager" />
                </div>
            )
        }
        <div class="post-body">
            <Content />
        </div>
        <footer class="post-footer">
            <a href="/posts" class="back-link">← 返回博客列表</a>
            <a href="/" class="back-link">返回首页</a>
        </footer>
    </article>
</BaseLayout>

<script>
    import '../../scripts/copy-code';
</script>

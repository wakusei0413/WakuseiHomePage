---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.vue';
import { formatPostDateLabel, getPostStaticPaths, type PostPageProps } from '../../lib/posts';
import { siteConfig } from '../../data/site';

export { getPostStaticPaths as getStaticPaths };

const { frontmatter, Content, readingMinutes, prev, next } = Astro.props as PostPageProps;
const pub = formatPostDateLabel(frontmatter.pubDate);
const updated = formatPostDateLabel(frontmatter.updatedDate);
const siteUrl = Astro.site ?? new URL('https://www.wakusei.top');
const ogImage = frontmatter.cover
    ? new URL(frontmatter.cover, siteUrl).toString()
    : new URL(siteConfig.profile.avatar, siteUrl).toString();
---

<BaseLayout
    shellMode="article"
    shellTitle={frontmatter.title}
    title={frontmatter.title}
    description={frontmatter.description}
    ogImage={ogImage}
>
    <div class="reading-progress" aria-hidden="true">
        <div class="reading-progress__fill"></div>
    </div>
    <button type="button" class="back-to-top" aria-label="返回顶部">
        <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
    </button>
    <article class="post-container">
        <div class="post-lead">
            <header class="post-header">
                <h1 class="post-title">{frontmatter.title}</h1>
                <div class="post-meta">
                    {
                        frontmatter.tags && frontmatter.tags.length > 0 && (
                            <span class="post-tags">{frontmatter.tags.join(' · ')}</span>
                        )
                    }
                    {
                        pub && (
                            <time class="post-date" datetime={pub.iso}>
                                {pub.label}
                            </time>
                        )
                    }
                    <span class="post-reading-time">约 {readingMinutes} 分钟阅读</span>
                    {
                        updated && pub && updated.iso !== pub.iso && (
                            <time class="post-date post-date--updated" datetime={updated.iso}>
                                更新于 {updated.label}
                            </time>
                        )
                    }
                </div>
            </header>
            {
                frontmatter.cover && (
                    <div class="post-hero-image-wrapper">
                        <img
                            src={frontmatter.cover}
                            alt={frontmatter.title}
                            class="post-hero-image"
                            loading="eager"
                            decoding="async"
                            fetchpriority="high"
                            width="1400"
                            height="788"
                        />
                    </div>
                )
            }
        </div>
        <div class="post-body">
            <Content />
        </div>
        <footer class="post-footer">
            <a href="/#posts" class="back-link">← 返回文章列表</a>
            <a href="/" class="back-link">返回首页</a>
        </footer>
        <nav class="post-nav" aria-label="文章导航">
            {
                prev ? (
                    <a class="post-nav__card post-nav__card--prev" data-internal-nav href={`/posts/${prev.slug}`}>
                        <span class="post-nav__dir">← 上一篇</span>
                        <span class="post-nav__title">{prev.title}</span>
                        {prev.dateLabel && <span class="post-nav__date">{prev.dateLabel}</span>}
                    </a>
                ) : (
                    <span class="post-nav__placeholder" />
                )
            }
            {
                next ? (
                    <a class="post-nav__card post-nav__card--next" data-internal-nav href={`/posts/${next.slug}`}>
                        <span class="post-nav__dir">下一篇 →</span>
                        <span class="post-nav__title">{next.title}</span>
                        {next.dateLabel && <span class="post-nav__date">{next.dateLabel}</span>}
                    </a>
                ) : (
                    <span class="post-nav__placeholder" />
                )
            }
        </nav>
    </article>
    <ArticleToc client:load />
</BaseLayout>

<script>
    import '../../scripts/article-runtime';
</script>

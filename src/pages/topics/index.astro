---
import TopicsPage from '../../components/TopicsPage.vue';
import { siteConfig } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translate } from '../../lib/i18n';
import { loadPublishedPosts, loadTaxonomyTerms } from '../../lib/posts';

const categories = await loadTaxonomyTerms('category');
const tags = await loadTaxonomyTerms('tag');
const postCount = (await loadPublishedPosts()).length;
const metaParams = { categories: categories.length, tags: tags.length, posts: postCount };
const title = translate(siteConfig.i18n.defaultLocale, 'pages.topics.title', metaParams);
const description = translate(siteConfig.i18n.defaultLocale, 'pages.topics.description', metaParams);
---

<BaseLayout shellMode="blog" shellTitle={title} title={`${title} | ${siteConfig.title}`} description={description}>
    <TopicsPage
        client:idle
        titleKey="pages.topics.title"
        descriptionKey="pages.topics.description"
        metaParams={metaParams}
        categories={categories}
        tags={tags}
        postCount={postCount}
    />
</BaseLayout>

---
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/transitions.css';
import '../styles/components.css';
import '../styles/responsive.css';
import '../styles/dock.css';
import '../styles/topbar.css';
import '../styles/footer.css';
import '../styles/article.css';

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.vue';
import SiteShell from '../components/SiteShell.vue';
import TopBar from '../components/TopBar.vue';
import { siteConfig } from '../data/site';

interface Props {
    title?: string;
    description?: string;
    shellMode?: 'home' | 'blog' | 'article' | 'error';
    shellTitle?: string;
}

const {
    title = siteConfig.title,
    description = siteConfig.description,
    shellMode = 'error',
    shellTitle = title
} = Astro.props;
const isHomePage = shellMode === 'home';
const DARK_THEME_BG = '#080808';
const googleFontsUrl =
    'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap';
const wallpaperOrigins = Array.from(
    new Set(
        siteConfig.wallpaper.apis.flatMap((api) => {
            try {
                return [new URL(api).origin];
            } catch {
                return [];
            }
        })
    )
);
const siteUrl = Astro.site ?? new URL('https://www.wakusei.top');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(siteConfig.profile.avatar, siteUrl).toString();
const ogLocale = siteConfig.lang.replace('-', '_');
---

<!doctype html>
<html lang={siteConfig.lang} class:list={[isHomePage && 'is-home']} transition:name="root" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>

        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content={siteConfig.themeColor} />
        <style is:inline set:html={`:root{--theme-color:${siteConfig.themeColor}}`}></style>
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={`${siteConfig.profile.name} avatar`} />
        <meta property="og:locale" content={ogLocale} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <link rel="icon" href="/res/img/logo.png" type="image/png" />
        <link rel="preload" href={siteConfig.profile.avatar} as="image" fetchpriority="high" />
        <style is:inline>
            :root {
                --bg: #fffef7;
                --z-loading: 9998;
                --z-noise: 9999;
                --border-width: 4px;
                --fg: #0a0a0a;
                --panel-border: #0a0a0a;
                --panel-shadow: 4px 4px 0 0 #0a0a0a;
                --curve-delicate: cubic-bezier(0.1, 0.9, 0.2, 1);
                --font-display: 'Times New Roman', 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
                --font-mono: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
                --muted: #666666;
            }
            [data-theme='dark'] {
                --bg: #080808;
                --fg: #e0e0e0;
                --panel-border: var(--fg);
                --panel-shadow: 4px 4px 0 0 var(--fg);
                --muted: #999999;
            }
            .loading-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: var(--bg, #fffef7);
                z-index: 9998;
                z-index: var(--z-loading, 9998);
                display: flex;
                align-items: center;
                justify-content: center;
                transition:
                    opacity 0.4s ease,
                    visibility 0.4s ease;
            }
            .loading-overlay.hidden {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }
            .loading-panel {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 1.5rem;
                padding: 3rem;
                border: var(--border-width) solid var(--panel-border, #0a0a0a);
                background: var(--bg, #fffef7);
                box-shadow: var(--panel-shadow, 4px 4px 0 0 #0a0a0a);
                border-radius: 4px;
                animation: loading-fade-in 0.8s cubic-bezier(0.1, 0.9, 0.2, 1);
            }
            @keyframes loading-fade-in {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .loading-spinner {
                width: 40px;
                height: 40px;
                border: 4px solid var(--fg, #0a0a0a);
                background: var(--bg, #fffef7);
                animation:
                    loading-rotate 1s linear infinite,
                    loading-pulse 0.8s ease-in-out infinite;
            }
            @keyframes loading-rotate {
                from {
                    transform: rotate(0deg);
                }
                to {
                    transform: rotate(360deg);
                }
            }
            @keyframes loading-pulse {
                0%,
                100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.4;
                }
            }
            .loading-text {
                font-family: var(--font-display, 'Times New Roman', serif);
                font-size: 1.25rem;
                font-weight: 400;
                letter-spacing: 0.04em;
                color: var(--fg, #0a0a0a);
                min-height: 1.5em;
            }
            .loading-progress {
                width: 200px;
                height: 12px;
                border: 3px solid var(--fg, #0a0a0a);
                background: var(--bg, #fffef7);
                position: relative;
                overflow: hidden;
            }
            .loading-bar {
                height: 100%;
                background: var(--fg, #0a0a0a);
                width: 0%;
                transition: width 0.3s ease-out;
                position: relative;
                overflow: hidden;
            }
            .loading-percent {
                font-family: var(--font-mono, monospace);
                font-size: 0.875rem;
                color: var(--muted, #666666);
            }
            /* Push noise overlay behind loading overlay when it's visible */
            html:not(.is-loaded) .noise-overlay {
                z-index: 9997 !important;
                opacity: 0.01 !important;
            }
        </style>

        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {wallpaperOrigins.map((origin) => <link rel="dns-prefetch" href={origin} />)}
        {wallpaperOrigins.map((origin) => <link rel="preconnect" href={origin} media="(min-width: 901px)" />)}
        <link href={googleFontsUrl} rel="preload" as="style" onload={"this.onload=null;this.rel='stylesheet'"} />
        <noscript>
            <link href={googleFontsUrl} rel="stylesheet" />
        </noscript>
        <ClientRouter />
        <script is:inline define:vars={{ darkBg: DARK_THEME_BG }}>
            (function () {
                var theme = localStorage.getItem('theme');
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-theme', theme);
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
                var appliedTheme = document.documentElement.getAttribute('data-theme');
                if (appliedTheme === 'dark') {
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', darkBg);
                }
            })();
        </script>
    </head>
    <body class:list={[isHomePage && 'is-home']}>
        <div id="navigationProgress" class="navigation-progress" aria-hidden="true">
            <div id="navigationProgressBar" class="navigation-progress__bar"></div>
        </div>
        <div id="globalLoadingOverlay" class="loading-overlay">
            <div class="loading-panel">
                <div class="loading-spinner"></div>
                <div id="globalLoadingText" class="loading-text">{siteConfig.loading.texts[0]}</div>
                <div class="loading-progress">
                    <div id="globalLoadingBar" class="loading-bar" style="width: 0%"></div>
                </div>
                <div id="globalLoadingPercent" class="loading-percent">0%</div>
            </div>
        </div>
        <script is:inline define:vars={{ loadingTexts: siteConfig.loading.texts }}>
            (function () {
                var storageKey = '__wakusei_skip_entry_loader';
                var overlay = document.getElementById('globalLoadingOverlay');
                var text = document.getElementById('globalLoadingText');
                var bar = document.getElementById('globalLoadingBar');
                var percentLabel = document.getElementById('globalLoadingPercent');
                var skipEntryLoader = sessionStorage.getItem('__wakusei_skip_entry_loader') === 'true';
                var progress = 0;
                var textIndex = 0;
                var pageLoaded = false;
                var homepageReady = false;
                var shellReady = false;
                var hidden = false;
                var progressTimer;
                var textTimer;

                function setProgress(value) {
                    progress = Math.max(progress, Math.min(100, Math.round(value)));
                    if (bar) bar.style.width = progress + '%';
                    if (percentLabel) percentLabel.textContent = progress + '%';
                }

                function hideOverlay() {
                    if (hidden) return;
                    hidden = true;
                    setProgress(100);
                    window.setTimeout(function () {
                        if (overlay) overlay.classList.add('hidden');
                        window.clearInterval(progressTimer);
                        window.clearInterval(textTimer);
                        sessionStorage.removeItem(storageKey);
                        document.documentElement.classList.add('is-loaded');
                    }, 250);
                }

                function shouldWaitForHomepage() {
                    const isHomeRoute =
                        document.documentElement.classList.contains('is-home') ||
                        document.body.classList.contains('is-home');
                    return isHomeRoute && !homepageReady;
                }

                // 所有页面统一等待 shell（壁纸）就绪后再隐藏 overlay，
                // 避免非首页因 pageLoad 先于壁纸就绪而出现壁纸未加载完成的闪动。
                // 壁纸加载失败时 loadInitialImages 仍会 allSettled 并触发 onReady，overlay 不会卡死。
                function shouldWaitForShell() {
                    return !shellReady;
                }

                function maybeHideOverlay() {
                    if (!pageLoaded || shouldWaitForShell() || shouldWaitForHomepage()) return;
                    hideOverlay();
                }

                if (!overlay) return;

                if (skipEntryLoader) {
                    overlay.classList.add('hidden');
                    sessionStorage.removeItem('__wakusei_skip_entry_loader');
                    document.documentElement.classList.add('is-loaded');
                    return;
                }

                window.addEventListener('wakusei:homepage-ready', function () {
                    homepageReady = true;
                    maybeHideOverlay();
                });

                window.addEventListener('wakusei:shell-ready', function () {
                    shellReady = true;
                    maybeHideOverlay();
                });

                progressTimer = window.setInterval(function () {
                    if (progress < 90) setProgress(progress + 3);
                }, 100);

                if (loadingTexts.length > 1 && text) {
                    textTimer = window.setInterval(function () {
                        textIndex = (textIndex + 1) % loadingTexts.length;
                        text.textContent = loadingTexts[textIndex];
                    }, 900);
                }

                if (document.readyState === 'complete') {
                    pageLoaded = true;
                    maybeHideOverlay();
                } else {
                    window.addEventListener(
                        'load',
                        function () {
                            pageLoaded = true;
                            maybeHideOverlay();
                        },
                        { once: true }
                    );
                }
            })();
        </script>
        <div id="pageScroller" class="page-scroller">
            <div transition:name="site-shell" transition:persist>
                <SiteShell client:load showTopBar={false} />
            </div>
            <div
                id="pageTransitionSurface"
                class="page-transition-surface"
                data-shell-mode={shellMode}
                data-page-title={shellTitle}
                data-is-home={isHomePage ? 'true' : 'false'}
                transition:name="page-content"
            >
                <slot />
            </div>
            <div class="page-footer" transition:name="site-footer" transition:persist>
                <Footer
                    client:load
                    links={siteConfig.footer.links}
                    socialLinks={siteConfig.socialLinks.links}
                    copyrightText={siteConfig.footer.text}
                />
            </div>
        </div>
        <TopBar client:load initialIsHomePage={isHomePage} />
        <noscript>
            <style>
                .container {
                    filter: none;
                    pointer-events: auto;
                }
                .loading-overlay {
                    display: none;
                }
            </style>
        </noscript>
        <script is:inline define:vars={{ darkBg: DARK_THEME_BG, themeColor: siteConfig.themeColor }}>
            if (!window.__wakuseiNavigationRuntimeInitialized) {
                window.__wakuseiNavigationRuntimeInitialized = true;

                (function () {
                    var showDelay = 120;
                    var showTimer;
                    var trickleTimer;
                    var hideTimer;
                    var resourceTimeout;
                    var resourceProbeTimer;
                    var pendingReadyHandler;
                    var progressVisible = false;
                    var value = 0;
                    var navigationEpoch = 0;

                    function getNavigationProgressElements() {
                        const progress = document.getElementById('navigationProgress');
                        const bar = document.getElementById('navigationProgressBar');
                        return { progress, bar };
                    }

                    function setValue(nextValue) {
                        var elements = getNavigationProgressElements();
                        value = Math.max(value, Math.min(nextValue, 100));
                        if (elements.bar) elements.bar.style.transform = 'scaleX(' + value / 100 + ')';
                    }

                    function clearPendingResourceWait() {
                        if (resourceTimeout) {
                            window.clearTimeout(resourceTimeout);
                            resourceTimeout = undefined;
                        }
                        if (resourceProbeTimer) {
                            window.clearTimeout(resourceProbeTimer);
                            resourceProbeTimer = undefined;
                        }
                        if (pendingReadyHandler) {
                            window.removeEventListener('wakusei:homepage-ready', pendingReadyHandler);
                            window.removeEventListener('wakusei:shell-ready', pendingReadyHandler);
                            pendingReadyHandler = undefined;
                        }
                    }

                    function isIncomingHomeReady() {
                        const carrier = document.getElementById('pageTransitionSurface');
                        const isHome = carrier && carrier.dataset.isHome === 'true';
                        if (!isHome) return false;
                        return !!document.querySelector('.container.visible');
                    }

                    function reset() {
                        var elements = getNavigationProgressElements();
                        window.clearTimeout(showTimer);
                        window.clearInterval(trickleTimer);
                        window.clearTimeout(hideTimer);
                        clearPendingResourceWait();
                        progressVisible = false;
                        value = 0;
                        if (elements.bar) elements.bar.style.transform = 'scaleX(0)';
                        if (elements.progress) {
                            elements.progress.classList.remove('navigation-progress--visible');
                            elements.progress.classList.remove('navigation-progress--done');
                        }
                    }

                    function start() {
                        navigationEpoch += 1;
                        reset();
                        progressVisible = true;
                        showTimer = window.setTimeout(function () {
                            var elements = getNavigationProgressElements();
                            if (!elements.progress) return;
                            elements.progress.classList.add('navigation-progress--visible');
                            setValue(12);
                            trickleTimer = window.setInterval(function () {
                                setValue(value + Math.max(1, (88 - value) * 0.12));
                            }, 180);
                        }, showDelay);
                    }

                    function finish() {
                        var elements = getNavigationProgressElements();
                        window.clearTimeout(showTimer);
                        window.clearInterval(trickleTimer);
                        clearPendingResourceWait();
                        if (!elements.progress) return;
                        if (!progressVisible) {
                            reset();
                            return;
                        }
                        elements.progress.classList.add('navigation-progress--visible');
                        setValue(100);
                        elements.progress.classList.add('navigation-progress--done');
                        hideTimer = window.setTimeout(reset, 260);
                    }

                    function waitForResources() {
                        clearPendingResourceWait();
                        const epoch = navigationEpoch;

                        if (!incomingIsHomePage) {
                            finish();
                            return;
                        }

                        function settle() {
                            if (epoch !== navigationEpoch) return;
                            finish();
                        }

                        pendingReadyHandler = function () {
                            settle();
                        };

                        window.addEventListener('wakusei:homepage-ready', pendingReadyHandler);
                        window.addEventListener('wakusei:shell-ready', pendingReadyHandler);

                        resourceTimeout = window.setTimeout(settle, 10000);

                        resourceProbeTimer = window.setTimeout(function () {
                            if (epoch !== navigationEpoch) return;
                            if (isIncomingHomeReady()) {
                                settle();
                            }
                        }, 0);
                    }

                    document.addEventListener('astro:before-preparation', function () {
                        start();
                    });
                    document.addEventListener('astro:after-swap', function () {
                        waitForResources();
                    });
                })();

                function getActiveTheme() {
                    const storedTheme = localStorage.getItem('theme');
                    if (storedTheme === 'dark' || storedTheme === 'light') return storedTheme;
                    const currentTheme = document.documentElement.getAttribute('data-theme');
                    if (currentTheme === 'dark' || currentTheme === 'light') return currentTheme;
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
                    return 'light';
                }

                let incomingIsHomePage = document.documentElement.classList.contains('is-home');

                function applyHomePageChromeState(isHome) {
                    const h = document.documentElement;
                    const b = document.body;
                    if (isHome) {
                        h.classList.add('is-home');
                        b.classList.add('is-home');
                    } else {
                        h.classList.remove('is-home');
                        b.classList.remove('is-home');
                    }
                }

                function getShellStateFromDocument(doc) {
                    const carrier = doc.getElementById('pageTransitionSurface');
                    if (!carrier) {
                        return { title: '', mode: 'error', isHomePage: false };
                    }
                    const mode =
                        carrier.dataset.shellMode === 'home' ||
                        carrier.dataset.shellMode === 'blog' ||
                        carrier.dataset.shellMode === 'article' ||
                        carrier.dataset.shellMode === 'error'
                            ? carrier.dataset.shellMode
                            : 'error';
                    return {
                        title: carrier.dataset.pageTitle || '',
                        mode: mode,
                        isHomePage: carrier.dataset.isHome === 'true'
                    };
                }

                function dispatchShellState(nextState) {
                    window.dispatchEvent(new CustomEvent('wakusei:shell-page-change', { detail: nextState }));
                }

                document.addEventListener('astro:before-swap', (event) => {
                    sessionStorage.setItem('__wakusei_skip_entry_loader', 'true');
                    event.newDocument.documentElement.classList.add('is-loaded');
                    const incomingOverlay = event.newDocument.querySelector('#globalLoadingOverlay');
                    if (incomingOverlay) incomingOverlay.classList.add('hidden');

                    incomingIsHomePage =
                        event.newDocument.documentElement.classList.contains('is-home') ||
                        event.newDocument.body.classList.contains('is-home');
                    dispatchShellState(getShellStateFromDocument(event.newDocument));

                    const theme = getActiveTheme();
                    const nextThemeColor = theme === 'dark' ? darkBg : themeColor;
                    event.newDocument.documentElement.setAttribute('data-theme', theme);
                    const incomingThemeColor = event.newDocument.querySelector('meta[name="theme-color"]');
                    if (incomingThemeColor) incomingThemeColor.setAttribute('content', nextThemeColor);
                });

                document.addEventListener('astro:after-swap', () => {
                    sessionStorage.removeItem('__wakusei_skip_entry_loader');
                    applyHomePageChromeState(incomingIsHomePage);
                    const scroller =
                        document.getElementById('pageScroller') || document.querySelector('.page-scroller');
                    if (scroller) scroller.scrollTo({ top: 0 });
                });
            }
        </script>
    </body>
</html>

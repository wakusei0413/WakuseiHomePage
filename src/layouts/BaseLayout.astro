---
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/transitions.css';
import '../styles/components.css';
import '../styles/responsive.css';
import '../styles/dock.css';
import '../styles/topbar.css';
import '../styles/footer.css';
import '../styles/article.css';
import '../styles/toc.css';
import '../styles/reading-controls.css';

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.vue';
import SiteShell from '../components/SiteShell.vue';
import TopBar from '../components/TopBar.vue';
import { siteConfig } from '../data/site';
import { loadFeaturedPosts, loadRecentlyUpdatedPost, loadSiteStats } from '../lib/posts';
import { createBlogPostingJsonLd, serializeJsonLd, type ArticleSeoMetadata } from '../lib/seo';

interface Props {
    title?: string;
    description?: string;
    shellMode?: 'home' | 'blog' | 'article' | 'error';
    shellTitle?: string;
    ogImage?: string;
    ogImageAlt?: string;
    articleSeo?: ArticleSeoMetadata;
    paginationPrev?: string;
    paginationNext?: string;
}

const {
    title = siteConfig.title,
    description = siteConfig.description,
    shellMode = 'error',
    shellTitle = title,
    ogImage,
    ogImageAlt,
    articleSeo,
    paginationPrev,
    paginationNext
} = Astro.props;
const isHomePage = shellMode === 'home';
const [featuredPosts, siteStats] = await Promise.all([loadFeaturedPosts(3), loadSiteStats()]);
const recentlyUpdated = await loadRecentlyUpdatedPost(featuredPosts.map((p) => p.slug));
const DARK_THEME_BG = '#080808';
const wallpaperOrigins = Array.from(
    new Set(
        siteConfig.wallpaper.apis.flatMap((api) => {
            try {
                return [new URL(api).origin];
            } catch {
                return [];
            }
        })
    )
);
const siteUrl = Astro.site ?? new URL('https://www.wakusei.top');
const siteHomeUrl = new URL('/', siteUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage
    ? ogImage.startsWith('http')
        ? ogImage
        : new URL(ogImage, siteUrl).toString()
    : new URL(siteConfig.profile.avatar, siteUrl).toString();
const resolvedOgImageAlt = ogImageAlt ?? (articleSeo?.image ? title : `${siteConfig.profile.name} avatar`);
const ogLocale = (articleSeo?.language ?? siteConfig.lang).replace('-', '_');
const blogPosting = articleSeo
    ? createBlogPostingJsonLd({
          ...articleSeo,
          canonicalUrl,
          headline: title,
          description,
          publisher: {
              name: siteConfig.profile.name,
              url: siteHomeUrl,
              image: new URL(siteConfig.profile.avatar, siteUrl).toString()
          }
      })
    : undefined;
const serializedBlogPosting = blogPosting ? serializeJsonLd(blogPosting) : undefined;
const googleFontsUrl =
    'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap';
---

<!doctype html>
<html
    lang={siteConfig.lang}
    class:list={[isHomePage && 'is-home', 'is-loaded', 'is-entering']}
    transition:name="root"
    transition:animate="none"
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>

        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content={siteConfig.themeColor} />
        <style is:inline set:html={`:root{--theme-color:${siteConfig.themeColor}}`}></style>
        <link rel="canonical" href={canonicalUrl} />
        {paginationPrev && <link rel="prev" href={new URL(paginationPrev, siteUrl).toString()} />}
        {paginationNext && <link rel="next" href={new URL(paginationNext, siteUrl).toString()} />}
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />
        <link rel="alternate" type="application/atom+xml" title={`${siteConfig.title} Atom`} href="/atom.xml" />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={articleSeo ? 'article' : 'website'} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={resolvedOgImageAlt} />
        <meta property="og:locale" content={ogLocale} />
        {articleSeo && <meta name="author" content={articleSeo.author.name} />}
        {articleSeo?.author.url && <meta property="article:author" content={articleSeo.author.url} />}
        {articleSeo && <meta property="article:published_time" content={articleSeo.publishedTime} />}
        {articleSeo && <meta property="article:modified_time" content={articleSeo.modifiedTime} />}
        {blogPosting?.articleSection && <meta property="article:section" content={blogPosting.articleSection} />}
        {blogPosting?.keywords?.map((tag) => <meta property="article:tag" content={tag} />)}
        {serializedBlogPosting && <script is:inline type="application/ld+json" set:html={serializedBlogPosting} />}
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <link rel="icon" href="/res/img/logo.png" type="image/png" />
        <link rel="preload" href={siteConfig.profile.avatar} as="image" fetchpriority="high" />
        <style is:inline>
            :root {
                --bg: #fffef7;
                --z-loading: 9998;
                --z-noise: 9999;
                --border-width: 4px;
                --fg: #0a0a0a;
                /* 与 base.css 保持一致，避免首帧硬边框→软玻璃跳变 */
                --panel-border: rgba(0, 0, 0, 0.2);
                --panel-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
                --curve-delicate: cubic-bezier(0.1, 0.9, 0.2, 1);
                --curve-snap: cubic-bezier(0.16, 1, 0.3, 1);
                --font-display: 'Times New Roman', 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
                --font-mono: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
                --muted: #666666;
            }
            [data-theme='dark'] {
                --bg: #080808;
                --fg: #e0e0e0;
                --panel-border: rgba(255, 255, 255, 0.12);
                --panel-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
                --muted: #999999;
            }
        </style>

        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {wallpaperOrigins.map((origin) => <link rel="dns-prefetch" href={origin} media="(min-width: 901px)" />)}
        {wallpaperOrigins.map((origin) => <link rel="preconnect" href={origin} media="(min-width: 901px)" />)}
        <script
            is:inline
            define:vars={{
                wallpaperDefault: siteConfig.wallpaper.defaultImage ?? '',
                wallpaperApi: siteConfig.wallpaper.apis[0] ?? ''
            }}
        >
            (function () {
                if (window.__wallpaperPrefetch) return;
                if (document.querySelector('.wallpaper-image')) return;
                if (!window.matchMedia || !window.matchMedia('(min-width: 901px)').matches) return;
                try {
                    var img = new Image();
                    img.decoding = 'async';
                    // Low priority: the wallpaper is decorative, so it must never
                    // compete with the avatar/hero text (the LCP element) or the web
                    // fonts during the critical first paint. It is a tiny self-hosted
                    // file, so low priority still lands well before the user notices.
                    if ('fetchPriority' in img) img.fetchPriority = 'low';
                    // Prefer the local default image for the first frame: it is a small
                    // self-hosted WebP that paints instantly, so the hero is never blank
                    // while the external rotation API (wallpaperApi) responds. The
                    // controller still rotates to the external API for variety.
                    var src = wallpaperDefault || wallpaperApi;
                    if (!src) return;
                    if (/^https?:\/\//i.test(src)) img.crossOrigin = 'anonymous';
                    img.src = src;
                    window.__wallpaperPrefetch = { img: img };
                } catch (e) {}
            })();
        </script>
        <link href={googleFontsUrl} rel="preload" as="style" onload={"this.onload=null;this.rel='stylesheet'"} />
        <noscript>
            <link href={googleFontsUrl} rel="stylesheet" />
        </noscript>
        <ClientRouter />
        <script is:inline define:vars={{ darkBg: DARK_THEME_BG, validLocales: siteConfig.i18n.locales }}>
            (function () {
                var theme = localStorage.getItem('theme');
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-theme', theme);
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
                // Keep <html lang> in sync with the persisted locale before first
                // paint so the page language never lags the stored choice.
                var storedLang = localStorage.getItem('lang');
                if (storedLang && validLocales.indexOf(storedLang) !== -1) {
                    document.documentElement.lang = storedLang;
                }
                var appliedTheme = document.documentElement.getAttribute('data-theme');
                if (appliedTheme === 'dark') {
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', darkBg);
                }
            })();
        </script>
    </head>
    <body class:list={[isHomePage && 'is-home']}>
        <script is:inline>
            (function () {
                function reveal() {
                    requestAnimationFrame(function () {
                        requestAnimationFrame(function () {
                            document.documentElement.classList.remove('is-entering');
                        });
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', reveal);
                } else {
                    reveal();
                }
            })();
        </script>
        <div id="navigationProgress" class="navigation-progress" aria-hidden="true">
            <div id="navigationProgressBar" class="navigation-progress__bar"></div>
        </div>
        <div id="pageScroller" class="page-scroller">
            <div transition:name="site-shell" transition:persist>
                <SiteShell
                    client:idle
                    showTopBar={false}
                    initialMode={shellMode}
                    initialTitle={shellTitle}
                    initialIsHomePage={isHomePage}
                    featuredPosts={featuredPosts}
                    siteStats={siteStats}
                    recentlyUpdated={recentlyUpdated}
                />
            </div>
            <div
                id="pageTransitionSurface"
                class="page-transition-surface"
                data-shell-mode={shellMode}
                data-page-title={shellTitle}
                data-is-home={isHomePage ? 'true' : 'false'}
                transition:name="page-content"
            >
                <slot />
            </div>
            <div class="page-footer" transition:name="site-footer" transition:persist>
                <Footer client:idle copyrightText={siteConfig.footer.text} />
            </div>
        </div>
        <TopBar client:idle initialIsHomePage={isHomePage} />
        <noscript>
            <style>
                .container {
                    filter: none;
                    pointer-events: auto;
                }
                .loading-overlay {
                    display: none;
                }
                html.is-entering .left-panel .hero > .avatar-box,
                html.is-entering .left-panel .hero > .name,
                html.is-entering .left-panel .hero > .status-bar,
                html.is-entering .left-panel .hero > .bio-container,
                html.is-entering .left-panel .hero > .social-links,
                html.is-entering .left-panel .hero > .social-links-wrapper {
                    opacity: 1;
                    transform: none;
                }
                html.is-entering .left-panel,
                html.is-entering .top-bar {
                    opacity: 1;
                    transform: none;
                }
            </style>
        </noscript>
        <script>
            import '../scripts/navigation-runtime';
            import '../scripts/inertial-scroll';
        </script>
    </body>
</html>

---
import '../../css/base.css';
import '../../css/layout.css';
import '../../css/components.css';
import '../../css/responsive.css';
import '../styles/dock.css';

import { siteConfig } from '../data/site';

interface Props {
    title?: string;
    description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
// Must match [data-theme='dark'] { --bg } in base.css
const DARK_THEME_BG = '#0a0a1a';
const googleFontsUrl =
    'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Space+Grotesk:wght@400;700&family=Noto+Sans+SC:wght@400;700&display=swap';
const wallpaperOrigins = Array.from(
    new Set(
        siteConfig.wallpaper.apis.flatMap((api) => {
            try {
                return [new URL(api).origin];
            } catch {
                return [];
            }
        })
    )
);
---

<!doctype html>
<html lang={siteConfig.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>

        <meta name="description" content={description} />
        <meta name="theme-color" content={siteConfig.themeColor} />
        <style is:inline set:html={`:root{--theme-color:${siteConfig.themeColor}}`}></style>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="icon" href="/res/img/logo.png" type="image/png" />
        <link rel="preload" href={siteConfig.profile.avatar} as="image" fetchpriority="high" />

        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {wallpaperOrigins.map((origin) => <link rel="dns-prefetch" href={origin} />)}
        {wallpaperOrigins.map((origin) => <link rel="preconnect" href={origin} media="(min-width: 901px)" />)}
        <link href={googleFontsUrl} rel="preload" as="style" onload={"this.onload=null;this.rel='stylesheet'"} />
        <noscript>
            <link href={googleFontsUrl} rel="stylesheet" />
        </noscript>
        <script is:inline define:vars={{ darkBg: DARK_THEME_BG }}>
            (function () {
                var theme = localStorage.getItem('theme');
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-theme', theme);
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
                var appliedTheme = document.documentElement.getAttribute('data-theme');
                if (appliedTheme === 'dark') {
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', darkBg);
                }
            })();
        </script>
    </head>
    <body>
        <slot />
        <noscript>
            <style>
                .container {
                    filter: none;
                    pointer-events: auto;
                }
                .loading-overlay {
                    display: none;
                }
            </style>
        </noscript>
    </body>
</html>

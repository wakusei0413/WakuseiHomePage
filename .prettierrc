{
    "plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 120,
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
        {
            "files": ["*.css"],
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": ["*.astro"],
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": ["*.svelte"],
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
